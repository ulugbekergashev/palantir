# Cerebro sozlamalari. Nusxa oling: .env (bu fayl git'ga tushmaydi)

# Admin panel paroli (#/admin — klinikalarni qo'shish). Bo'sh bo'lsa admin kirishi yopiq
ADMIN_PASSWORD=

# Telegram bot tokeni (@BotFather → /newbot). Bo'lmasa panel ishlaydi, lekin bot va avtomatik joylash o'chiq
BOT_TOKEN=

# Claude API kaliti (platform.claude.com). Bo'lmasa matn tayyor namunalardan olinadi
ANTHROPIC_API_KEY=
# Model (standart: claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Server porti (panel shu portda ham ochiladi: npm run build && npm start)
PORT=3200

# Baza va maxfiy kalit shu papkada (hostingda — doimiy disk / volume)
DATA_DIR=./data

# Dushanba nechida paket yuboriladi (Toshkent vaqti)
# SEND_HOUR=9
