# Palantir sozlamalari. Nusxa oling: .env (bu fayl git'ga tushmaydi)

# Admin panel paroli (#/admin — bizneslarni qo'shish). Bo'sh bo'lsa admin kirishi yopiq
ADMIN_PASSWORD=

# Kalitlar (bot tokeni, Claude, Gemini, Groq, VoiceLab, SpeechLab, TG_API_ID/HASH) — ulash ustasida kiritish qulayroq: #/ulash.
# U yerda kiritilgani tekshiriladi, bazada shifrlanib saqlanadi va shu fayldagidan ustun turadi; bu yerdagisi — zaxira.

# Telegram bot tokeni (@BotFather → /newbot). Bo'lmasa panel ishlaydi, lekin Telegram, eslatmalar va kanal o'chiq
BOT_TOKEN=

# Claude API kaliti (platform.claude.com) — yordamchining "miyasi". Bo'lmasa yordamchi javob bermaydi
ANTHROPIC_API_KEY=
# Model (standart: claude-opus-5-5)
# AI_MODEL=claude-opus-5-5
# Internetdan qidirish (kurs, narx, qonun, yangilik). 0 — o'chiq
# WEB_SEARCH=1

# Ovozli xabar → matn. Gemini o'zbekchani yaxshi taniydi (aistudio.google.com, bepul kalit);
# Groq Whisper — zaxira (console.groq.com). Ikkalasi ham bo'lmasa, ovoz o'chiq
# VoiceLab (Aisha) — o'zbek nutqiga ixtisoslashgan; bo'lsa birinchi ishlatiladi: voicelab.uz → Dasturchi → API kalit (vlk_...)
VOICELAB_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Instagram Direct — asosiy yo'l rasmiy (Meta ilovasi, Palantir Hub orqali): Hub kodi ulash ustasida kiritiladi (docs/INSTAGRAM.md).
# Meta «Human Agent» ruxsatini bergan bo'lsa — 24 soatdan keyin ham (7 kungacha) javob berish mumkin
# IG_HUMAN_AGENT=0

# ─── Keyinga qoldirilgan kanallar (docs/PLAN.md) — standart o'chiq, panelda ko'rinmaydi ───
# Egasining shaxsiy Telegrami (GramJS, akkauntga kod bilan kiradi). Yoqish: TG_PERSONAL=1 va my.telegram.org → API development tools
# TG_PERSONAL=0
TG_API_ID=
TG_API_HASH=
# Instagram brauzer orqali (norasmiy zaxira yo'l: akkaunt cheklanishi mumkin). Yoqish: IG_VIA_BROWSER=1
# IG_VIA_BROWSER=0
# Eslatma vaqtida Telegram orqali AI qo'ng'iroq (alohida Telegram akkaunt, tgvoice/call_live.py). Yoqish: TG_CALL=1 va pastdagi TG_CALL_*
# TG_CALL=0

# Instagram brauzer orqali yoqilgan bo'lsa (IG_VIA_BROWSER=1): egasining akkaunti shu kompyuterdagi Chrome yoki Edge orqali.
# Brauzer o'zi topiladi; boshqa joyda bo'lsa — yo'lini bering
# IG_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
# Bir kunda Instagram'da yuboriladigan xabarlar chegarasi (akkaunt xavfsizligi)
# IG_DAILY_LIMIT=120
# Direct'ni tekshirish oralig'i, ms (har safar ±30% tasodifiy). Kichraytirmang: tez-tez so'rov akkauntga shubha uyg'otadi
# IG_POLL_MS=90000
# 1 — brauzer ko'rinib ishlaydi (muammoni ko'rish uchun)
# IG_SHOW_BROWSER=0

# DentaCRM (klinikalar): manzil, login va parol panelda kiritiladi — bu yerda faqat chegaralar.
# Bir nechta biznesga xizmat qiladigan umumiy serverda 0 qiling: ichki tarmoq manzillariga ulanish yopiladi
# CRM_ALLOW_PRIVATE=1
# Yordamchi bir kunda CRM'ga yoza oladigan qabullar soni
# CRM_DAILY_BOOKINGS=40
# Resepshn bir kunda egasining tasdig'isiz yoza oladigan qabullar soni (oshsa — faqat tasdiq bilan)
# CRM_PUBLIC_DAILY_BOOKINGS=15
# Bir kunda Palantir orqali (egasi tasdiqlab) CRM'ga kiritiladigan pul yozuvlari soni
# CRM_DAILY_MONEY=30
# Bir kunda egasi yuborgan nechta rasm ko'rib chiqiladi (har biri — AI xarajati)
# AI_DAILY_PHOTOS=50
# Bir kunda kamera kadriga AI qarashi («kameraga qara», AI zonalarni belgilasin, kamera topshiriqlari)
# AI_DAILY_CAMERA=150
# Bir kunda bitta biznes uchun model so'rovlari chegarasi: egasining yordamchisi va mijozlarga javob.
# Tugasa Palantir buni egasiga aytadi va pul sarflamaydi (spam yoki aylanib qolgan suhbat hisobni bo'shatib qo'ymasin)
# AI_DAILY_OWNER=600
# AI_DAILY_CUSTOMER=400
# Bitta pul yozuvining eng katta summasi va bir kunda jami (so'm)
# CRM_MAX_AMOUNT=100000000
# CRM_DAILY_SUM=500000000

# Server porti (panel shu portda ham ochiladi: npm run build && npm start)
PORT=3200

# Server tinglaydigan manzil. 127.0.0.1 (standart) — faqat shu kompyuterdan ochiladi; 0.0.0.0 — tarmoqdagi hamma qurilmalardan
# (hostingda, proksi ortida). Panel shifrsiz (http): klinika tarmog'iga ochilsa parol ochiq ketadi
LISTEN_HOST=127.0.0.1
# Server oldida proksi (nginx, hosting) tursa 1 qiling: shunda mijozning haqiqiy IP'si olinadi. To'g'ridan-to'g'ri ochiq serverda 1 qilmang
# TRUST_PROXY=0

# Baza, «ikkinchi miya», jurnal va maxfiy kalit shu papkada (hostingda — doimiy disk / volume).
# Klinika kompyuterida dastur papkasidan tashqarida bo'lsin (masalan C:PalantirData): dastur yangilanganda o'chib ketmaydi
DATA_DIR=./data
# Kunlik zaxira nusxalar (baza, ikkinchi miya, maxfiy kalit) papkasi va necha kun saqlanishi. Boshqa disk bo'lgani yaxshi. 0 — zaxira olinmaydi
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# Qo'ng'iroq yozuvlari (audio) necha kun saqlanadi — matni va tahlili qoladi; 0 — o'chirilmaydi
# RECORDINGS_KEEP_DAYS=90
# Ma'lumotlar diskida shundan kam bo'sh joy qolsa (MB) — egasiga Telegram'da aytiladi
# DISK_MIN_FREE_MB=2048

# Avtomatik yangilash (scripts/update.mjs): har kecha UPDATE_HOUR da imzolangan yangi reliz bo'lsa — sinab, o'rnatadi; ishlamasa qaytaradi.
# Dasturchi nusxasida (.git bor) o'chiq. 0 — o'chiq
# UPDATE_AUTO=1
# UPDATE_HOUR=3
# Reliz manbai (standart — GitHub Releases)
# UPDATE_URL=https://github.com/ulugbekergashev/palantir/releases/latest/download

# Ertalabki xulosa va kechki «kun qanday o'tdi» savoli soatlari (Toshkent vaqti; 99 — yuborilmaydi)
# MORNING_HOUR=8
# EVENING_HOUR=19
# Administratorga so'rov eslatmalari beriladigan soatlar: tungi so'rov ertalab eslatiladi, tunda karta ovozsiz keladi
# REQUEST_HOURS=8-21

# Kamera: odam zonada shuncha soniya tursa — seans boshlanadi; shuncha ko'rinmasa — tugaydi; bundan qisqa o'tirish bemor deb sanalmaydi.
# Stol ustida tez sinab ko'rish uchun: 3 / 5 / 5
# CAMERA_ENTER_SEC=20
# CAMERA_LEAVE_SEC=60
# CAMERA_MIN_SESSION_SEC=180
# Kechki kamera hisoboti soati (99 — yuborilmaydi); kutish joyida shuncha daqiqadan ko'p kutsa — egasiga xabar;
# kresloda o'tirgan bemorga «to'lov yozilmagan» deyishdan oldin kutish; kamera yopilgan/burilgan holat shuncha davom etsa — xabar
# CAMERA_REPORT_HOUR=20
# CAMERA_WAIT_ALERT_MIN=20
# CAMERA_PAY_GRACE_MIN=30
# CAMERA_TAMPER_HOLD_SEC=120
# IP kameralar (RTSP) uchun ffmpeg. PATH'da bo'lsa shart emas; yo'q bo'lsa IP kameralar o'chiq (kompyuterning o'z kamerasi ishlayveradi)
# FFMPEG_PATH=C:Users...AppDataLocalMicrosoftWinGetLinksfmpeg.exe
# Telefon qilib eslatish — SpeechLab AI agenti (speechlab.uz → Integratsiyalar → API va Webhook'lar: «AI agent qo'ng'iroqlari» ruxsati).
# SpeechLab panelida telefon liniyasi ulangan, chiquvchi agent yaratilgan va balans bo'lishi kerak. Agent yo'riqnomasida {{eslatma}} va {{vaqt}}
# SPEECHLAB_API_KEY=
# SPEECHLAB_AGENT_ID=
# Telefon liniyasisiz: eslatma vaqtida Telegram orqali AI qo'ng'iroq (tgvoice/call_live.py — Gemini Live, alohida Telegram akkaunt).
# TG_CALL=1 va ikkalasi berilsa yoqiladi (o'rnatgich yo'llarni o'zi yozadi); skript CEREBRO_URL va CEREBRO_TOKEN'ni Palantir'dan oladi.
# Chiqish kodi: 0 — gaplashildi, 2 — ko'tarmadi
# TG_CALL_PYTHON=C:/Palantir/tgvoice/.venv/Scripts/python.exe
# TG_CALL_SCRIPT=C:/Palantir/tgvoice/call_live.py
# Telefon liniyasi (tgvoice/sip_live.py + Asterisk WSL'da): egasining SIP ilovasi paroli (login: egasi) va bir vaqtdagi qo'ng'iroqlar
# SIP_OWNER_PASSWORD=
# SIP_MAX_CALLS=4
# Ovozli agent bir kunda yoza oladigan qabullar
# VOICE_DAILY_BOOKINGS=30
