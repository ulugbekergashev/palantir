{
  "name": "cerebro",
  "private": true,
  "version": "0.1.0",
  "description": "Cerebro — har qanday biznes uchun AI yordamchi (Telegram + panel)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --port 3100 --host localhost",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning --import tsx server/index.ts",
    "preview": "vite preview --port 3101 --host localhost",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx scripts/e2e.ts",
    "test:ui": "tsx scripts/ui-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "telegraf": "^4.16.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
