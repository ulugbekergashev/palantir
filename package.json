{
  "name": "palantir",
  "private": true,
  "version": "0.1.0",
  "description": "Palantir — har qanday biznes uchun AI yordamchi (Telegram + panel)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --port 3100 --host localhost",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning --import tsx server/index.ts",
    "serve": "node scripts/supervise.mjs",
    "stop": "node scripts/supervise.mjs stop",
    "status": "node scripts/supervise.mjs status",
    "check": "node --no-warnings --import tsx scripts/preflight.ts",
    "preview": "vite preview --port 3101 --host localhost",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx scripts/e2e.ts",
    "test:resilience": "tsx scripts/e2e-resilience.ts",
    "test:setup": "tsx scripts/e2e-setup.ts",
    "test:ui-setup": "tsx scripts/ui-setup.ts",
    "test:work": "tsx scripts/e2e-work.ts",
    "test:requests": "tsx scripts/e2e-requests.ts",
    "test:phone": "tsx scripts/e2e-phone.ts",
    "test:instagram": "tsx scripts/e2e-instagram.ts",
    "test:dashboard": "vite build && tsx scripts/e2e-dashboard.ts",
    "hub": "tsx hub/server.ts",
    "test:tgcall": "tsx scripts/e2e-tgcall.ts",
    "test:ipcam": "tsx scripts/e2e-ipcam.ts",
    "test:camwork": "tsx scripts/e2e-camwork.ts",
    "test:httpcam": "tsx scripts/e2e-httpcam.ts",
    "test:ui": "vite build && tsx scripts/ui-live.ts",
    "crm:probe": "tsx scripts/crm-probe.ts",
    "crm:live": "tsx scripts/crm-live.ts",
    "camera:model": "tsx scripts/fetch-model.ts",
    "demo": "tsx scripts/demo.ts",
    "stend": "tsx scripts/stend.ts",
    "test:stend": "tsx scripts/e2e-stend.ts",
    "scenarios": "tsx scripts/scenarios.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "big-integer": "^1.6.52",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.12",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
