{
  "manifest_version": 3,
  "name": "Palantir",
  "version": "1.0.0",
  "description": "Palantir yordamchisi sizning Chrome'ingizda o'z vkladkalarida ishlaydi (sizning vkladkalaringizga tegmaydi).",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Palantir"
  },
  "icons": {
    "128": "icon128.png"
  }
}
